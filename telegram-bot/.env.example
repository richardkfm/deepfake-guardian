# Telegram Bot configuration
TELEGRAM_BOT_TOKEN=your-bot-token-here
ENGINE_URL=http://engine:8000

# Must match API_KEY set in engine/.env (leave empty if engine auth is disabled)
ENGINE_API_KEY=

# Per-request timeout for engine calls, in seconds (video moderation is the slow path)
ENGINE_TIMEOUT_SECONDS=60

# Language for admin notification messages (en | de)
BOT_LANGUAGE=en

# Media larger than this (MB) is moderated via its thumbnail instead of being
# downloaded. The Telegram Bot API cannot download files over 20 MB.
# 0 = no limit (only useful with a self-hosted Bot API server).
MAX_MEDIA_MB=20

# Minimum seconds between two @-mentions of the admins in the same chat
# (notices are still posted, just without pinging). 0 = always mention.
ADMIN_MENTION_COOLDOWN_SECONDS=60

# Logging
LOG_LEVEL=info
