# WhatsApp Bot configuration
ENGINE_URL=http://engine:8000

# Must match API_KEY set in engine/.env (leave empty if engine auth is disabled)
ENGINE_API_KEY=

# Per-request timeout for engine calls, in seconds (video moderation is the slow path)
ENGINE_TIMEOUT_SECONDS=60

# Language for notices when the engine reports none, and for command replies (en | de)
BOT_LANGUAGE=en

# Media larger than this (MB) is moderated via its embedded thumbnail instead
# of being downloaded. 0 = no limit.
MAX_MEDIA_MB=20

# Minimum seconds between two @-mentions of the admins in the same group
# (notices are still posted, just without pinging). 0 = always mention.
ADMIN_MENTION_COOLDOWN_SECONDS=60

# Path to store Baileys auth session data
SESSION_DATA_PATH=./auth_info

# Logging
LOG_LEVEL=info
